---
import '../styles/globals.css';
import Footer from '../components/layout/Footer.astro';
import { locales, getOgLocale } from '../i18n/dictionary';
import { hreflangGroups } from '../data/localizedPages';

const { lang, dict, customHreflangs, canonical } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || ''; // normalize trailing slash
const cleanPath = currentPath.replace(new RegExp(`^/${lang}`), '') || '';

// Compute alternate hreflang links
let alternateLinks = [];
if (customHreflangs && typeof customHreflangs === 'object') {
  alternateLinks = Object.entries(customHreflangs).map(([hreflang, href]) => ({ hreflang, href }));
  if (!customHreflangs['x-default']) {
    const xDef = customHreflangs['en'] || Object.values(customHreflangs)[0];
    if (xDef) alternateLinks.push({ hreflang: 'x-default', href: xDef });
  }
} else {
  // Check if currentPath is in hreflangGroups
  const matchedGroup = Object.values(hreflangGroups).find(group => 
    Object.values(group).includes(currentPath)
  );

  if (matchedGroup) {
    alternateLinks = Object.entries(matchedGroup).map(([hLang, path]) => ({
      hreflang: hLang,
      href: `https://keep-pdf.online${path}`
    }));
    const xDefault = matchedGroup['en'] || Object.values(matchedGroup)[0];
    alternateLinks.push({
      hreflang: 'x-default',
      href: `https://keep-pdf.online${xDefault}`
    });
  } else {
    alternateLinks = locales.map(loc => ({
      hreflang: loc,
      href: `https://keep-pdf.online/${loc}${cleanPath}`
    }));
    alternateLinks.push({
      hreflang: 'x-default',
      href: `https://keep-pdf.online/en${cleanPath}`
    });
  }
}
const canonicalUrl = canonical || `https://keep-pdf.online${currentPath}`;

// Breadcrumb JSON-LD
const pathSegments = currentPath.split('/').filter(Boolean);
const breadcrumbItems = [
  { name: 'KeepPDF', url: 'https://keep-pdf.online/' },
  ...pathSegments.map((seg, i) => ({
    name: seg.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()),
    url: `https://keep-pdf.online/${pathSegments.slice(0, i + 1).join('/')}`
  }))
];
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems.map((item, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": item.name,
    "item": item.url
  }))
};

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "KeepPDF",
    "image": "https://keep-pdf.online/og-image.png",
    "description": dict.hero.description,
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Any",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.8",
      "ratingCount": "1250",
      "bestRating": "5"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "KeepPDF",
    "url": "https://keep-pdf.online/",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://keep-pdf.online/{search_term_string}",
      "query-input": "required name=search_term_string"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "KeepPDF",
    "url": "https://keep-pdf.online",
    "logo": "https://keep-pdf.online/brand-logo.svg",
    "sameAs": []
  }
];

const title = Astro.props.title || dict.metadata.title;
const description = Astro.props.description || dict.metadata.description;
const howToSchema = Astro.props.howToSchema;
const isHomePage = currentPath === `/${lang}` || currentPath === '';
const faqSchema = Astro.props.faqSchema || (isHomePage && dict?.faq?.questions?.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": dict.faq.questions.map(q => ({
    "@type": "Question",
    "name": q.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": q.answer
    }
  }))
} : null);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#4f46e5" />
    <meta name="google-site-verification" content="Dtk44oghP1kgx1BgnOr6z8L03e43sO5T7ID9k1ZvUAE" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={dict.common?.metaKeywords || "PDF, merge, split, compress, convert, tools, online, free"} />
    <meta name="author" content="KeepPDF Team" />
    <link rel="icon" href="/brand-logo.svg" />
    <link rel="apple-touch-icon" href="/brand-logo.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalUrl} />
    {alternateLinks.map(link => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="KeepPDF" />
    <meta property="og:locale" content={getOgLocale(lang)} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://keep-pdf.online/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://keep-pdf.online/og-image.png" />

    <!-- Google Fonts (optimized: preload + swap) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" /></noscript>

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-VY5X32BG7G"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-VY5X32BG7G');
    </script>

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {howToSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    )}
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
  </head>
  <body class="antialiased min-h-screen flex flex-col font-sans text-slate-900 bg-white">
    <slot name="navbar" />
    <main class="flex-grow pt-20">
      <slot />
    </main>
    <Footer lang={lang} dict={dict} />
    <slot name="cookie-banner" />
  </body>
</html>
