---
import '../styles/globals.css';
import Footer from '../components/layout/Footer.astro';
import { getOgLocale } from '../i18n/dictionary';

const { lang, dict, post, translations } = Astro.props;
const currentPath = Astro.url.pathname;
const canonicalUrl = `https://keep-pdf.online${currentPath}`;

// Dynamic OG image: use post cover or generate via og-image service
const ogImage = post.data.image
    ? (post.data.image.startsWith('http') ? post.data.image : `https://keep-pdf.online${post.data.image}`)
    : `https://og.tailgraph.com/og?fontFamily=Inter&title=${encodeURIComponent(post.data.title)}&titleTailwind=font-bold+text-4xl+text-white&bg=4F46E5&footer=keep-pdf.online&footerTailwind=text-indigo-200+text-lg`;

// Word count for schema
const bodyText = typeof post.body === 'string' ? post.body : '';
const wordCount = bodyText.split(/\s+/).filter(Boolean).length;

// Article JSON-LD — enhanced
const articleJsonLd = {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.data.title,
    "description": post.data.description,
    "image": ogImage,
    "datePublished": post.data.date.toISOString(),
    "dateModified": post.data.date.toISOString(),
    "wordCount": wordCount,
    "keywords": post.data.tags?.join(', ') || '',
    "inLanguage": lang,
    "author": {
        "@type": "Organization",
        "name": post.data.author || 'KeepPDF Team',
        "url": "https://keep-pdf.online"
    },
    "publisher": {
        "@type": "Organization",
        "name": "KeepPDF",
        "url": "https://keep-pdf.online",
        "logo": {
            "@type": "ImageObject",
            "url": "https://keep-pdf.online/brand-logo.svg",
            "width": 200,
            "height": 60
        }
    },
    "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonicalUrl
    }
};

// BreadcrumbList for blog post
const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "KeepPDF", "item": "https://keep-pdf.online/" },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": `https://keep-pdf.online/${lang}/blog` },
        { "@type": "ListItem", "position": 3, "name": post.data.title, "item": canonicalUrl }
    ]
};
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#4f46e5" />
    <title>{post.data.title} | KeepPDF Blog</title>
    <meta name="description" content={post.data.description} />
    <meta name="keywords" content={post.data.tags?.join(', ')} />
    <meta name="author" content={post.data.author || 'KeepPDF Team'} />
    <link rel="icon" href="/brand-logo.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- hreflang for translations -->
    {translations && translations.map(t => (
      <link rel="alternate" hreflang={t.lang} href={`https://keep-pdf.online/${t.lang}/blog/${t.slug}`} />
    ))}
    <link rel="alternate" hreflang={lang} href={canonicalUrl} />
    {(() => {
      const enTranslation = translations?.find(t => t.lang === 'en');
      const xDefaultHref = lang === 'en' ? canonicalUrl : (enTranslation ? `https://keep-pdf.online/en/blog/${enTranslation.slug}` : canonicalUrl);
      return <link rel="alternate" hreflang="x-default" href={xDefaultHref} />;
    })()}

    <!-- Open Graph (Article) -->
    <meta property="og:title" content={post.data.title} />
    <meta property="og:description" content={post.data.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="KeepPDF" />
    <meta property="og:locale" content={getOgLocale(lang)} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="article:published_time" content={post.data.date.toISOString()} />
    <meta property="article:author" content={post.data.author || 'KeepPDF Team'} />
    {post.data.tags?.map((tag: string) => (
      <meta property="article:tag" content={tag} />
    ))}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={post.data.title} />
    <meta name="twitter:description" content={post.data.description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-VY5X32BG7G"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-VY5X32BG7G');
    </script>

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </head>
  <body class="antialiased min-h-screen flex flex-col font-sans text-slate-900 bg-white">
    <slot name="navbar" />
    <main class="flex-grow pt-20">
      <slot />
    </main>
    <Footer lang={lang} dict={dict} />
    <slot name="cookie-banner" />
    <!-- Vercel Analytics -->
    <script defer src="/_vercel/insights/script.js"></script>
  </body>
</html>
