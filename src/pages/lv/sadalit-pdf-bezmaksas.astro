---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import { getDictionary } from '../../i18n/dictionary';
import Navbar from '../../components/landing/Navbar';
import CookieBanner from '../../components/landing/CookieBanner';
import SplitClient from '../../components/tools/SplitClient';

const lang = 'lv';
const dict = getDictionary(lang);

const seoTitle = "Sadalīt PDF Bezmaksas — Izdalīt Lapas Bez Reģistrācijas | KeepPDF";
const seoDescription = "Sadalīt PDF bezmaksas tiešsaistē. Izdaliet lapas no PDF bez reģistrācijas — 100% pārlūkā.";

const howToSchema = {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "Kā Sadalīt PDF Bezmaksas 3 Soļos",
    "description": "Sadalīt PDF bezmaksas ar KeepPDF.",
    "step": [
        {
            "@type": "HowToStep",
            "position": 1,
            "name": "Augšupielādējiet PDF",
            "text": "Izvēlieties vai velciet PDF failu."
        },
        {
            "@type": "HowToStep",
            "position": 2,
            "name": "Izvēlieties Lapas",
            "text": "Noklikšķiniet uz lapām vai ievadiet numurus."
        },
        {
            "@type": "HowToStep",
            "position": 3,
            "name": "Lejupielādējiet",
            "text": "Nospiediet \"Izdalīt\" un lejupielādējiet!"
        }
    ]
};

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
        {
            "@type": "Question",
            "name": "Vai PDF sadalīšana ir bezmaksas?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Jā! Bez ierobežojumiem."
            }
        },
        {
            "@type": "Question",
            "name": "Cik lapas var izdalīt?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Cik vēlaties."
            }
        }
    ]
};
---

<Layout lang={lang} dict={dict} title={seoTitle} description={seoDescription}>
    <Navbar client:load lang={lang} dict={dict} slot="navbar" />

    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <!-- Hreflang -->
    <link rel="alternate" hreflang="en" href={"https://keep-pdf.com/en/split"} />
    <link rel="alternate" hreflang="tr" href={"https://keep-pdf.com/tr/split"} />
    <link rel="alternate" hreflang="sq" href={"https://keep-pdf.com/sq/ndaj-pdf-falas-online"} />
    <link rel="alternate" hreflang="et" href={"https://keep-pdf.com/et/tukkelda-pdf-tasuta"} />
    <link rel="alternate" hreflang="lv" href={"https://keep-pdf.com/lv/sadalit-pdf-bezmaksas"} />
    <link rel="alternate" hreflang="x-default" href={"https://keep-pdf.com/en/split"} />

    <!-- Hero Section -->
    <section class="relative overflow-hidden pt-24 pb-16" style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%);">
        <div class="absolute inset-0 opacity-10">
            <div class="absolute top-20 left-10 w-72 h-72 bg-purple-400 rounded-full filter blur-3xl animate-pulse"></div>
            <div class="absolute bottom-10 right-20 w-96 h-96 bg-indigo-400 rounded-full filter blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
        </div>
        <div class="container-custom max-w-4xl mx-auto relative z-10 text-center px-4">
            <span class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm text-white/90 text-sm font-medium px-4 py-2 rounded-full border border-white/20 mb-6">
                🔒 100% privāti — faili nekad nepametīs jūsu pārlūku
            </span>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6" style="letter-spacing: -0.03em;">
                Sadalīt PDF Bezmaksas Tiešsaistē
                <span class="block text-indigo-300 text-2xl md:text-3xl font-semibold mt-3">Izdaliet Vajadzīgās Lapas</span>
            </h1>
            <div class="flex flex-wrap justify-center gap-4 mb-8">
                <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm px-4 py-2 rounded-xl text-white/80 text-sm">
                    <span class="text-green-400">✓</span> Vienmēr bezmaksas
                </div>
                <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm px-4 py-2 rounded-xl text-white/80 text-sm">
                    <span class="text-green-400">✓</span> Bez reģistrācijas
                </div>
                <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm px-4 py-2 rounded-xl text-white/80 text-sm">
                    <span class="text-green-400">✓</span> Bez augšupielādes serverī
                </div>
            </div>
        </div>
    </section>

    <!-- Tool -->
    <section class="py-12 bg-slate-50">
        <div class="container-custom max-w-4xl mx-auto px-4">
    <SplitClient client:load dict={dict} />
        </div>
    </section>

    <!-- How To Section -->
    <section class="py-20 bg-white">
        <div class="container-custom max-w-5xl mx-auto px-4">
            <div class="text-center mb-14">
                <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-4">Kā Sadalīt PDF Bezmaksas 3 Soļos</h2>
                <p class="text-lg text-slate-500 max-w-2xl mx-auto">Sadalīt PDF bezmaksas ar KeepPDF.</p>
            </div>
            <div class="grid md:grid-cols-3 gap-8">
                <div class="relative bg-gradient-to-br from-indigo-50 to-white rounded-2xl p-8 border border-indigo-100 shadow-sm hover:shadow-lg transition-shadow">
                    <div class="absolute -top-4 -left-4 w-12 h-12 bg-indigo-600 text-white rounded-xl flex items-center justify-center text-lg font-bold shadow-lg">1</div>
                    <div class="text-4xl mb-4 mt-2">📂</div>
                    <h3 class="text-lg font-bold text-slate-900 mb-2">Augšupielādējiet PDF</h3>
                    <p class="text-slate-500 text-sm leading-relaxed">Izvēlieties vai velciet PDF failu.</p>
                </div>
                <div class="relative bg-gradient-to-br from-purple-50 to-white rounded-2xl p-8 border border-purple-100 shadow-sm hover:shadow-lg transition-shadow">
                    <div class="absolute -top-4 -left-4 w-12 h-12 bg-purple-600 text-white rounded-xl flex items-center justify-center text-lg font-bold shadow-lg">2</div>
                    <div class="text-4xl mb-4 mt-2">✂️</div>
                    <h3 class="text-lg font-bold text-slate-900 mb-2">Izvēlieties Lapas</h3>
                    <p class="text-slate-500 text-sm leading-relaxed">Noklikšķiniet uz lapām vai ievadiet numurus.</p>
                </div>
                <div class="relative bg-gradient-to-br from-emerald-50 to-white rounded-2xl p-8 border border-emerald-100 shadow-sm hover:shadow-lg transition-shadow">
                    <div class="absolute -top-4 -left-4 w-12 h-12 bg-emerald-600 text-white rounded-xl flex items-center justify-center text-lg font-bold shadow-lg">3</div>
                    <div class="text-4xl mb-4 mt-2">⬇️</div>
                    <h3 class="text-lg font-bold text-slate-900 mb-2">Lejupielādējiet</h3>
                    <p class="text-slate-500 text-sm leading-relaxed">Nospiediet "Izdalīt" un lejupielādējiet!</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Why Section -->
    <section class="py-20 bg-slate-50">
        <div class="container-custom max-w-5xl mx-auto px-4">
            <div class="text-center mb-14">
                <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-4">Kāpēc Sadalīt PDF ar KeepPDF?</h2>
                <p class="text-lg text-slate-500 max-w-2xl mx-auto">Ātri, droši un bezmaksas</p>
            </div>
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
                <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition-shadow text-center">
                    <div class="text-3xl mb-3">🔒</div>
                    <h3 class="font-bold text-slate-900 mb-2">100% Privāti</h3>
                    <p class="text-sm text-slate-500">Faili paliek pārlūkā.</p>
                </div>
                <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition-shadow text-center">
                    <div class="text-3xl mb-3">⚡</div>
                    <h3 class="font-bold text-slate-900 mb-2">Tūlītēji Rezultāti</h3>
                    <p class="text-sm text-slate-500">Sadaliet sekundēs.</p>
                </div>
                <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition-shadow text-center">
                    <div class="text-3xl mb-3">💰</div>
                    <h3 class="font-bold text-slate-900 mb-2">Pilnībā Bezmaksas</h3>
                    <p class="text-sm text-slate-500">Konts nav nepieciešams.</p>
                </div>
                <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition-shadow text-center">
                    <div class="text-3xl mb-3">📱</div>
                    <h3 class="font-bold text-slate-900 mb-2">Jebkurā Ierīcē</h3>
                    <p class="text-sm text-slate-500">Dators, telefons, planšete.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-20 bg-white">
        <div class="container-custom max-w-3xl mx-auto px-4">
            <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 text-center mb-12">Kā Sadalīt PDF Bezmaksas FAQ</h2>
            <div class="space-y-4">
                <details class="group bg-slate-50 rounded-xl border border-slate-200 overflow-hidden">
                    <summary class="flex items-center justify-between p-6 cursor-pointer font-semibold text-slate-900 hover:bg-slate-100 transition-colors">
                        Vai PDF sadalīšana ir bezmaksas?
                        <span class="text-indigo-500 group-open:rotate-45 transition-transform text-xl">+</span>
                    </summary>
                    <div class="px-6 pb-6 text-slate-600 leading-relaxed">Jā! Bez ierobežojumiem.</div>
                </details>
                <details class="group bg-slate-50 rounded-xl border border-slate-200 overflow-hidden">
                    <summary class="flex items-center justify-between p-6 cursor-pointer font-semibold text-slate-900 hover:bg-slate-100 transition-colors">
                        Cik lapas var izdalīt?
                        <span class="text-indigo-500 group-open:rotate-45 transition-transform text-xl">+</span>
                    </summary>
                    <div class="px-6 pb-6 text-slate-600 leading-relaxed">Cik vēlaties.</div>
                </details>
            </div>
        </div>
    </section>

    <!-- Internal Links -->
    <section class="py-16 bg-indigo-50">
        <div class="container-custom max-w-4xl mx-auto px-4 text-center">
            <div class="flex flex-wrap justify-center gap-4">
                <a href="/lv/apvienot-pdf-bezmaksas" class="inline-flex items-center gap-2 bg-white text-indigo-700 font-semibold px-6 py-3 rounded-xl border border-indigo-200 hover:border-indigo-400 hover:shadow-md transition-all text-sm">
                    🔗 Apvienot PDF Bezmaksas
                </a>
                <a href="/lv/saspiest-pdf-bezmaksas" class="inline-flex items-center gap-2 bg-white text-indigo-700 font-semibold px-6 py-3 rounded-xl border border-indigo-200 hover:border-indigo-400 hover:shadow-md transition-all text-sm">
                    📦 Saspiest PDF Bezmaksas
                </a>
                <a href="/lv/split" class="inline-flex items-center gap-2 bg-white text-indigo-700 font-semibold px-6 py-3 rounded-xl border border-indigo-200 hover:border-indigo-400 hover:shadow-md transition-all text-sm">
                    🔧 PDF Sadalīšanas Rīks
                </a>
            </div>
        </div>
    </section>

    <CookieBanner client:load dict={dict} slot="cookie-banner" />
</Layout>
