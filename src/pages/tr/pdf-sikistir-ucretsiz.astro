---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import { getDictionary } from '../../i18n/dictionary';
import Navbar from '../../components/landing/Navbar';
import CookieBanner from '../../components/landing/CookieBanner';
import CompressClient from '../../components/tools/CompressClient';

const lang = 'tr';
const dict = getDictionary(lang);

const seoTitle = "PDF Sıkıştır Ücretsiz — PDF Dosya Boyutunu Küçült | KeepPDF";
const seoDescription = "PDF dosya boyutunu kaliteden ödün vermeden ücretsiz küçültün. E-Devlet, UYAP, e-posta veya ödev yüklemeleri için ideal PDF sıkıştırma aracı.";

const howToSchema = {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "PDF Dosyalarını Ücretsiz Sıkıştırmanın 3 Adımı",
    "description": "KeepPDF ile PDF belgelerinizin boyutunu tarayıcınızda saniyeler içinde küçültün.",
    "step": [
        {
            "@type": "HowToStep",
            "position": 1,
            "name": "PDF Dosyasını Yükleyin",
            "text": "Boyutunu küçültmek istediğiniz PDF belgesini yükleyin."
        },
        {
            "@type": "HowToStep",
            "position": 2,
            "name": "Sıkıştırma Seviyesini Seçin",
            "text": "Temel veya güçlü sıkıştırma modlarından birini seçin."
        },
        {
            "@type": "HowToStep",
            "position": 3,
            "name": "Küçültün ve İndirin",
            "text": "\"PDF Sıkıştır\" butonuna tıklayın ve optimize edilmiş PDF'inizi indirin."
        }
    ]
};

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
        {
            "@type": "Question",
            "name": "PDF sıkıştırma işlemi yazıların okunurluğunu bozar mı?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Temel sıkıştırma modunda metin kalitesi ve vektörler tamamen korunur. Güçlü sıkıştırma modu ise taranmış belgeler ve yüksek çözünürlüklü görseller için en yüksek boyut tasarrufunu sağlar."
            }
        },
        {
            "@type": "Question",
            "name": "UYAP ve E-Devlet için PDF boyutu küçültülebilir mi?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Evet! KeepPDF, UYAP ve E-Devlet sistemlerinin talep ettiği dosya boyutu sınırlarına (örneğin 5MB veya 10MB) uygun şekilde belgelerinizi küçültmek için idealdir."
            }
        }
    ]
};
---

<Layout lang={lang} dict={dict} title={seoTitle} description={seoDescription}>
    <Navbar client:load lang={lang} dict={dict} slot="navbar" />

    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <!-- Hero Section -->
    <section class="relative overflow-hidden pt-24 pb-16" style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%);">
        <div class="absolute inset-0 opacity-10">
            <div class="absolute top-20 left-10 w-72 h-72 bg-red-400 rounded-full filter blur-3xl animate-pulse"></div>
            <div class="absolute bottom-10 right-20 w-96 h-96 bg-rose-400 rounded-full filter blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
        </div>
        <div class="container-custom max-w-4xl mx-auto relative z-10 text-center px-4">
            <span class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm text-white/90 text-sm font-medium px-4 py-2 rounded-full border border-white/20 mb-6">
                🔒 %100 Gizli — Tarayıcıda güvenli dosya sıkıştırma
            </span>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6" style="letter-spacing: -0.03em;">
                PDF Sıkıştır Ücretsiz
                <span class="block text-indigo-300 text-2xl md:text-3xl font-semibold mt-3">Kaliteyi Koru, Dosya Boyutunu Küçült</span>
            </h1>
            <div class="flex flex-wrap justify-center gap-4 mb-8">
                <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm px-4 py-2 rounded-xl text-white/80 text-sm">
                    <span class="text-green-400">✓</span> %80'e varan küçültme
                </div>
                <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm px-4 py-2 rounded-xl text-white/80 text-sm">
                    <span class="text-green-400">✓</span> UYAP & E-Devlet Uyumlu
                </div>
                <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm px-4 py-2 rounded-xl text-white/80 text-sm">
                    <span class="text-green-400">✓</span> Sunucuya yükleme yok
                </div>
            </div>
        </div>
    </section>

    <!-- Tool -->
    <section class="py-12 bg-slate-50">
        <div class="container-custom max-w-4xl mx-auto px-4">
            <CompressClient client:load dict={dict} />
        </div>
    </section>

    <!-- How To Section -->
    <section class="py-20 bg-white">
        <div class="container-custom max-w-5xl mx-auto px-4">
            <div class="text-center mb-14">
                <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-4">PDF Boyutu Nasıl Küçültülür?</h2>
                <p class="text-lg text-slate-500 max-w-2xl mx-auto">KeepPDF ile PDF sıkıştırmak son derece basittir.</p>
            </div>
            <div class="grid md:grid-cols-3 gap-8">
                <div class="relative bg-gradient-to-br from-red-50 to-white rounded-2xl p-8 border border-red-100 shadow-sm hover:shadow-lg transition-shadow">
                    <div class="absolute -top-4 -left-4 w-12 h-12 bg-red-600 text-white rounded-xl flex items-center justify-center text-lg font-bold shadow-lg">1</div>
                    <div class="text-4xl mb-4 mt-2">📂</div>
                    <h3 class="text-lg font-bold text-slate-900 mb-2">PDF'i Seçin</h3>
                    <p class="text-slate-500 text-sm leading-relaxed">Sıkıştırmak istediğiniz PDF belgesini yükleyin.</p>
                </div>
                <div class="relative bg-gradient-to-br from-rose-50 to-white rounded-2xl p-8 border border-rose-100 shadow-sm hover:shadow-lg transition-shadow">
                    <div class="absolute -top-4 -left-4 w-12 h-12 bg-rose-600 text-white rounded-xl flex items-center justify-center text-lg font-bold shadow-lg">2</div>
                    <div class="text-4xl mb-4 mt-2">⚙️</div>
                    <h3 class="text-lg font-bold text-slate-900 mb-2">Modu Belirleyin</h3>
                    <p class="text-slate-500 text-sm leading-relaxed">Temel veya güçlü sıkıştırma seçeneklerinden birini seçin.</p>
                </div>
                <div class="relative bg-gradient-to-br from-emerald-50 to-white rounded-2xl p-8 border border-emerald-100 shadow-sm hover:shadow-lg transition-shadow">
                    <div class="absolute -top-4 -left-4 w-12 h-12 bg-emerald-600 text-white rounded-xl flex items-center justify-center text-lg font-bold shadow-lg">3</div>
                    <div class="text-4xl mb-4 mt-2">⬇️</div>
                    <h3 class="text-lg font-bold text-slate-900 mb-2">İndirin</h3>
                    <p class="text-slate-500 text-sm leading-relaxed">Küçültülmüş PDF belgenizi anında indirin.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-20 bg-slate-50 border-t border-slate-100">
        <div class="container-custom max-w-3xl mx-auto px-4">
            <div class="text-center mb-14">
                <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-4">Sıkça Sorulan Sorular</h2>
                <p class="text-lg text-slate-500">PDF sıkıştırma hakkında merak edilenler</p>
            </div>
            <div class="space-y-4">
                <div class="bg-white rounded-2xl p-6 border border-slate-200">
                    <h3 class="font-bold text-slate-900 mb-2">PDF sıkıştırma işlemi yazıların okunurluğunu bozar mı?</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">Temel sıkıştırma modunda metin kalitesi ve vektörler tamamen korunur. Güçlü sıkıştırma modu ise taranmış belgeler ve yüksek çözünürlüklü görseller için en yüksek boyut tasarrufunu sağlar.</p>
                </div>
                <div class="bg-white rounded-2xl p-6 border border-slate-200">
                    <h3 class="font-bold text-slate-900 mb-2">UYAP ve E-Devlet için PDF boyutu küçültülebilir mi?</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">Evet! KeepPDF, UYAP ve E-Devlet sistemlerinin talep ettiği dosya boyutu sınırlarına (örneğin 5MB veya 10MB) uygun şekilde belgelerinizi küçültmek için idealdir.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Related Links -->
    <section class="py-12 bg-white border-t border-slate-200">
        <div class="container-custom max-w-4xl mx-auto px-4 text-center">
            <h3 class="font-bold text-slate-700 mb-4 text-sm uppercase tracking-wider">İlgili Rehberler</h3>
            <div class="flex flex-wrap justify-center gap-3">
                <a href="/tr/blog/edevlet-uyap-pdf-hazirlama" class="inline-flex items-center gap-2 bg-slate-50 px-4 py-2 rounded-xl border border-slate-200 text-sm font-medium text-slate-700 hover:text-brand-600 hover:border-brand-200 transition-all shadow-sm">
                    📖 E-Devlet & UYAP PDF Hazırlama Rehberi
                </a>
                <a href="/tr/pdf-birlestir-ucretsiz" class="inline-flex items-center gap-2 bg-slate-50 px-4 py-2 rounded-xl border border-slate-200 text-sm font-medium text-slate-700 hover:text-brand-600 hover:border-brand-200 transition-all shadow-sm">
                    🔗 PDF Birleştir
                </a>
            </div>
        </div>
    </section>

    <CookieBanner client:idle dict={dict} slot="cookie-banner" />
</Layout>
