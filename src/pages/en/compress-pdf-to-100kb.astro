---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import { getDictionary } from '../../i18n/dictionary';
import Navbar from '../../components/landing/Navbar';
import CookieBanner from '../../components/landing/CookieBanner';
import CompressClient from '../../components/tools/CompressClient';

const lang = 'en';
const dict = getDictionary(lang);

const seoTitle = "Compress PDF to 100KB Online Free — For PAN Card, Passport & SSC | KeepPDF";
const seoDescription = "Compress PDF to 100KB online for free without losing quality. Ideal for NSDL PAN card, UTIITSL, Passport Seva, and SSC portal uploads. 100% private in your browser.";

const howToSchema = {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Compress PDF to 100KB Online for Free",
    "description": "Step-by-step tutorial on how to reduce your PDF file size under 100KB for government and job portal submissions using KeepPDF.",
    "step": [
        {
            "@type": "HowToStep",
            "position": 1,
            "name": "Upload Your PDF Document",
            "text": "Select or drag and drop the PDF file you need to reduce under 100KB."
        },
        {
            "@type": "HowToStep",
            "position": 2,
            "name": "Select '< 100 KB' Target Preset",
            "text": "Click on the '< 100 KB' target button or choose Strong compression mode to calculate exact byte budgets."
        },
        {
            "@type": "HowToStep",
            "position": 3,
            "name": "Download Your Optimized PDF",
            "text": "Click 'Compress PDF Now' and instantly download your sub-100KB document, verified and ready for portal upload."
        }
    ]
};

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
        {
            "@type": "Question",
            "name": "How do I compress a PDF to less than 100KB without losing text sharpness?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "KeepPDF utilizes intelligent client-side downsampling and DCT stream quantization. Rather than blurring vector fonts or smearing letters, it compresses embedded raster images, strips redundant metadata, deduplicates embedded objects, and optimizes color palettes so text remains crystal clear while the total file size drops below 100KB."
            }
        },
        {
            "@type": "Question",
            "name": "Which Indian government portals require PDF uploads under 100KB?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Major government portals requiring documents under 100KB include NSDL and UTIITSL PAN card portals (for identity and address proof), Passport Seva Kendra (PSK) supporting documentation uploads, SSC (Staff Selection Commission) recruitment applications, State Public Service Commissions (such as TNPSC, UPPSC, BPSC), and various university admission forms."
            }
        },
        {
            "@type": "Question",
            "name": "Is it safe to compress Aadhaar card or PAN card PDFs on KeepPDF?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes, 100% safe. Unlike traditional online PDF tools that upload your files to remote cloud servers where confidential personal data could be stored or intercepted, KeepPDF operates entirely inside your web browser via client-side WebAssembly and JavaScript. Your confidential documents never leave your laptop or smartphone."
            }
        },
        {
            "@type": "Question",
            "name": "Why did my government portal reject my compressed PDF?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Common reasons include: the file size was exactly 101KB or larger (strictly over the portal limit), the PDF was password-protected (e-Aadhaar comes encrypted with your birth year and name initials and must be unlocked first), the document dimensions exceeded standard A4 size, or the scanner DPI was configured improperly."
            }
        },
        {
            "@type": "Question",
            "name": "Can I compress a multi-page PDF to under 100KB?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes, but keep in mind that a 5-page PDF compressed to under 100KB leaves only ~20KB per page. If your document contains heavy color scans on every page, we recommend using grayscale mode or splitting unnecessary pages before compression to maintain optimal readability."
            }
        }
    ]
};
---

<Layout lang={lang} dict={dict} title={seoTitle} description={seoDescription} canonical="https://keep-pdf.online/en/compress-pdf-to-100kb">
    <Navbar client:load lang={lang} dict={dict} slot="navbar" />

    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <!-- Hero Section -->
    <section class="relative overflow-hidden pt-24 pb-16" style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #312e81 100%);">
        <div class="absolute inset-0 opacity-15">
            <div class="absolute top-10 left-1/4 w-80 h-80 bg-indigo-500 rounded-full filter blur-3xl animate-pulse"></div>
            <div class="absolute bottom-10 right-1/4 w-96 h-96 bg-emerald-500 rounded-full filter blur-3xl animate-pulse" style="animation-delay: 1.5s;"></div>
        </div>
        <div class="container-custom max-w-4xl mx-auto relative z-10 text-center px-4">
            <span class="inline-flex items-center gap-2 bg-emerald-500/10 border border-emerald-400/30 text-emerald-300 text-xs md:text-sm font-semibold px-4 py-2 rounded-full mb-6 backdrop-blur-md">
                🔒 100% Client-Side Privacy — Documents Never Leave Your Device
            </span>
            <h1 class="text-3xl md:text-5xl lg:text-6xl font-black text-white leading-tight mb-4 tracking-tight">
                Compress PDF to 100KB Online
                <span class="block text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-cyan-300 text-xl md:text-3xl font-bold mt-2">
                    Guaranteed Sub-100KB for PAN Card, Passport & SSC Portals
                </span>
            </h1>
            <p class="text-slate-300 text-base md:text-lg max-w-2xl mx-auto mb-8 leading-relaxed">
                Reduce your PDF file size strictly below 100 KB in seconds. Perfect for strict Indian government portals, recruitment exams, and university forms with zero quality loss.
            </p>

            <div class="flex flex-wrap justify-center gap-3 text-xs md:text-sm font-medium text-slate-200">
                <span class="bg-white/10 backdrop-blur-sm px-3.5 py-1.5 rounded-lg border border-white/10 flex items-center gap-1.5">
                    <span class="text-emerald-400 font-bold">✓</span> NSDL & UTIITSL PAN Ready
                </span>
                <span class="bg-white/10 backdrop-blur-sm px-3.5 py-1.5 rounded-lg border border-white/10 flex items-center gap-1.5">
                    <span class="text-emerald-400 font-bold">✓</span> Passport Seva Compatible
                </span>
                <span class="bg-white/10 backdrop-blur-sm px-3.5 py-1.5 rounded-lg border border-white/10 flex items-center gap-1.5">
                    <span class="text-emerald-400 font-bold">✓</span> SSC CGL / CHSL Verified
                </span>
                <span class="bg-white/10 backdrop-blur-sm px-3.5 py-1.5 rounded-lg border border-white/10 flex items-center gap-1.5">
                    <span class="text-emerald-400 font-bold">✓</span> No Watermark, No Login
                </span>
            </div>
        </div>
    </section>

    <!-- Interactive Compressor Tool Section -->
    <section class="py-12 bg-slate-50 border-b border-slate-200">
        <div class="container-custom max-w-4xl mx-auto px-4">
            <div class="bg-white p-6 md:p-8 rounded-3xl shadow-xl border border-slate-100">
                <div class="mb-6 text-center">
                    <span class="text-xs uppercase font-extrabold tracking-wider text-emerald-600 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
                        Target Compression Engine Active
                    </span>
                    <h2 class="text-2xl font-bold text-slate-900 mt-2">Upload File to Compress Below 100KB</h2>
                    <p class="text-sm text-slate-500">Select your file, choose the <strong>&lt; 100 KB</strong> target button, and get an instant download.</p>
                </div>
                <CompressClient client:load dict={dict} lang="en" />
            </div>
        </div>
    </section>

    <!-- In-Depth 500+ Word Guide Section -->
    <article class="py-16 bg-white">
        <div class="container-custom max-w-4xl mx-auto px-4 prose prose-slate max-w-none">
            
            <div class="border-l-4 border-indigo-600 pl-6 mb-12">
                <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 mb-2">
                    Why Government Portals Enforce the Strict 100KB PDF Limit
                </h2>
                <p class="text-slate-600 leading-relaxed">
                    If you have ever applied for an Indian PAN card, renewed your passport on the Passport Seva portal, or submitted an application for SSC (Staff Selection Commission), UPSC, IBPS, or State PSCs, you have likely encountered the dreaded error: <em>"Uploaded PDF file size exceeds the prescribed limit of 100 KB"</em>. 
                </p>
            </div>

            <p class="text-slate-700 leading-relaxed mb-6">
                Government servers in India manage tens of millions of citizen records every single month. To prevent system overloads, database memory exhaustion, and slow server response times during peak submission windows, government technical architectures impose rigid constraints on document file sizes. Documents such as <strong>Proof of Identity (POI)</strong>, <strong>Proof of Address (POA)</strong>, <strong>Date of Birth (DOB) certificates</strong>, and <strong>caste/income certificates</strong> are mandated to be within 100KB to 200KB. 
            </p>

            <h3 class="text-xl font-bold text-slate-900 mt-8 mb-4">
                Exact 100KB Upload Specifications Across Major Indian Portals
            </h3>
            <div class="overflow-x-auto my-6">
                <table class="w-full text-left border-collapse border border-slate-200 rounded-xl overflow-hidden text-sm">
                    <thead>
                        <tr class="bg-slate-100 text-slate-900 font-semibold">
                            <th class="p-3 border border-slate-200">Portal / Organization</th>
                            <th class="p-3 border border-slate-200">Document Type</th>
                            <th class="p-3 border border-slate-200">Max Size Allowed</th>
                            <th class="p-3 border border-slate-200">Recommended Resolution</th>
                        </tr>
                    </thead>
                    <tbody class="text-slate-600">
                        <tr class="hover:bg-slate-50">
                            <td class="p-3 border border-slate-200 font-medium text-slate-900">NSDL / Protean PAN Portal</td>
                            <td class="p-3 border border-slate-200">Form 49A/49AA supporting proofs</td>
                            <td class="p-3 border border-slate-200 text-emerald-600 font-bold">&le; 100 KB - 300 KB</td>
                            <td class="p-3 border border-slate-200">200 DPI Grayscale / Color</td>
                        </tr>
                        <tr class="hover:bg-slate-50">
                            <td class="p-3 border border-slate-200 font-medium text-slate-900">UTIITSL PAN Services</td>
                            <td class="p-3 border border-slate-200">Aadhaar, Voter ID, Ration Card</td>
                            <td class="p-3 border border-slate-200 text-emerald-600 font-bold">&le; 100 KB</td>
                            <td class="p-3 border border-slate-200">150 to 200 DPI Grayscale</td>
                        </tr>
                        <tr class="hover:bg-slate-50">
                            <td class="p-3 border border-slate-200 font-medium text-slate-900">Passport Seva Kendra (PSK)</td>
                            <td class="p-3 border border-slate-200">Annexure, Utility Bill, Passbook</td>
                            <td class="p-3 border border-slate-200 text-emerald-600 font-bold">&le; 100 KB - 200 KB</td>
                            <td class="p-3 border border-slate-200">A4 Dimensions, Max 200 DPI</td>
                        </tr>
                        <tr class="hover:bg-slate-50">
                            <td class="p-3 border border-slate-200 font-medium text-slate-900">Staff Selection Commission (SSC)</td>
                            <td class="p-3 border border-slate-200">Class 10 Marksheet, Category Cert.</td>
                            <td class="p-3 border border-slate-200 text-emerald-600 font-bold">50 KB &ndash; 100 KB</td>
                            <td class="p-3 border border-slate-200">Clean 150 DPI B&amp;W or Color</td>
                        </tr>
                        <tr class="hover:bg-slate-50">
                            <td class="p-3 border border-slate-200 font-medium text-slate-900">State PSCs &amp; University Admissions</td>
                            <td class="p-3 border border-slate-200">Graduation degree, Transfer certificate</td>
                            <td class="p-3 border border-slate-200 text-emerald-600 font-bold">&le; 100 KB</td>
                            <td class="p-3 border border-slate-200">Standard PDF/A or PDF 1.4+</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <h3 class="text-xl font-bold text-slate-900 mt-8 mb-4">
                The Technical Reason Scanned PDFs Are So Huge (And How KeepPDF Shrinks Them)
            </h3>
            <p class="text-slate-700 leading-relaxed mb-4">
                When you scan an Aadhaar card, mark sheet, or passport page using a home scanner or smartphone scanning app (such as CamScanner, Adobe Scan, or Document Scanner), the software typically saves the image in raw, uncompressed 300 to 600 DPI bitmap form. A single A4 page scanned at 300 DPI contains approximately <strong>8.7 million pixels</strong>. In full 24-bit RGB color, that uncompressed bitmap consumes over <strong>25 megabytes</strong> of memory! Even when wrapped into a standard PDF, the resulting file is frequently between 3MB and 12MB.
            </p>
            <p class="text-slate-700 leading-relaxed mb-4">
                Attempting to upload a 5MB file to an NSDL or SSC form will immediately trigger an upload rejection. Here is how KeepPDF reduces that file to less than 100KB while keeping your document completely sharp:
            </p>
            <ul class="list-disc pl-6 space-y-2 text-slate-700 mb-6">
                <li><strong>Dynamic Byte-Budgeting:</strong> KeepPDF calculates the exact byte allowance based on the total number of pages. For a single page targeting 100KB, it allocates a 95KB safety ceiling to ensure the generated file never exceeds 102,400 bytes.</li>
                <li><strong>Intelligent Discrete Cosine Transform (DCT) Quantization:</strong> Embedded photographic scans are re-encoded using high-efficiency JPEG compression algorithms specifically tuned for document legibility, removing invisible background color noise while keeping black text crisp.</li>
                <li><strong>Metadata &amp; Object Stream Stripping:</strong> Smartphone scanning applications embed extensive camera metadata, geolocation tags, device serial numbers, and unneeded color profiles. KeepPDF purges all unnecessary overhead, saving up to 40% of file size before image compression even begins.</li>
                <li><strong>Font Subsetting &amp; Vector Preservation:</strong> If your PDF originated from a word processor or digital government portal (such as e-Aadhaar or DigiLocker), digital text remains in vector format so you can zoom in 500% without any blurriness or pixelation.</li>
            </ul>

            <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-2xl my-8">
                <h4 class="text-amber-900 font-bold text-base mb-1">⚠️ Important: Handling Password-Protected e-Aadhaar Files</h4>
                <p class="text-amber-800 text-sm leading-relaxed">
                    Electronic Aadhaar PDFs downloaded from the UIDAI portal are encrypted by default with a password (the first 4 letters of your name in capital letters followed by your birth year, e.g., <code>KUMA1995</code>). Government portals such as PSK and NSDL will reject encrypted PDFs. Make sure to remove the password before uploading to KeepPDF for compression.
                </p>
            </div>

            <h3 class="text-xl font-bold text-slate-900 mt-8 mb-4">
                Why Client-Side Privacy Matters for Indian Applicants
            </h3>
            <p class="text-slate-700 leading-relaxed mb-4">
                Your Aadhaar card, PAN card, voter ID, and academic marksheets contain highly sensitive personal identifiable information (PII), including your full name, father's name, date of birth, biometric photo, signature, and permanent address. 
            </p>
            <p class="text-slate-700 leading-relaxed mb-6">
                Most popular online compression tools (such as iLovePDF, Smallpdf, or online converters) require you to transmit your files to their centralized web servers located in foreign jurisdictions. There is always a risk of server breaches, data retention, or unauthorized document indexing. 
                <strong>KeepPDF works fundamentally differently:</strong> using modern WebAssembly and JavaScript, all compression algorithms run locally inside your browser's memory sandbox. Your document is processed on your device and is never uploaded anywhere. You can even turn off your internet connection after the page loads and compress your files offline!
            </p>

            <h3 class="text-xl font-bold text-slate-900 mt-8 mb-4">
                Troubleshooting Common Government Portal Upload Rejections
            </h3>
            <div class="space-y-4 my-6">
                <div class="p-4 rounded-xl border border-slate-200 bg-slate-50">
                    <h5 class="font-bold text-slate-900 text-sm mb-1">❌ Error: "File size exceeds 100 KB limit"</h5>
                    <p class="text-slate-600 text-sm">
                        Some portals calculate 100KB as exactly 100,000 bytes rather than 102,400 bytes (100 KiB). When using KeepPDF, selecting the <code>&lt; 100 KB</code> preset automatically targets ~90 KB to 95 KB, ensuring that regardless of whether the portal uses decimal or binary calculation, your file will pass the validation check.
                    </p>
                </div>
                <div class="p-4 rounded-xl border border-slate-200 bg-slate-50">
                    <h5 class="font-bold text-slate-900 text-sm mb-1">❌ Error: "Invalid PDF format or corrupted stream"</h5>
                    <p class="text-slate-600 text-sm">
                        This error occurs when older government portals cannot parse modern PDF 2.0 structures or non-standard compression streams. KeepPDF compiles clean, standard-compliant PDF 1.7 documents compatible with all legacy government web portals.
                    </p>
                </div>
                <div class="p-4 rounded-xl border border-slate-200 bg-slate-50">
                    <h5 class="font-bold text-slate-900 text-sm mb-1">❌ Error: "Document illegible or text blurred"</h5>
                    <p class="text-slate-600 text-sm">
                        If your compressed scan looks blurry, the original scan may have had poor lighting or low contrast. Ensure your document is scanned in good lighting at 200 DPI, crop out dark table backgrounds, and choose the <strong>Basic Compression</strong> mode if your document contains digital vector text.
                    </p>
                </div>
            </div>

            <!-- Internal Linking Section -->
            <div class="mt-12 p-6 rounded-2xl bg-indigo-50/50 border border-indigo-100">
                <h4 class="font-bold text-slate-900 mb-3 text-base">Explore Related Indian Exam & Portal PDF Tools:</h4>
                <div class="flex flex-wrap gap-3">
                    <a href="/en/compress-pdf-to-200kb" class="inline-flex items-center gap-1.5 text-xs md:text-sm font-semibold text-indigo-700 bg-white px-3.5 py-2 rounded-xl border border-indigo-200 hover:border-indigo-400 hover:shadow-sm transition-all">
                        📄 Compress PDF to 200KB (UPSC & Sarkari) &rarr;
                    </a>
                    <a href="/en/merge-pdf" class="inline-flex items-center gap-1.5 text-xs md:text-sm font-semibold text-indigo-700 bg-white px-3.5 py-2 rounded-xl border border-indigo-200 hover:border-indigo-400 hover:shadow-sm transition-all">
                        🔗 Merge Marksheets & ID Proofs &rarr;
                    </a>
                    <a href="/en/pricing" class="inline-flex items-center gap-1.5 text-xs md:text-sm font-semibold text-indigo-700 bg-white px-3.5 py-2 rounded-xl border border-indigo-200 hover:border-indigo-400 hover:shadow-sm transition-all">
                        💳 Free Forever vs Paid Competitors &rarr;
                    </a>
                </div>
            </div>

        </div>
    </article>

    <!-- FAQ Section -->
    <section class="py-16 bg-slate-50 border-t border-slate-200">
        <div class="container-custom max-w-3xl mx-auto px-4">
            <div class="text-center mb-12">
                <span class="text-xs uppercase font-extrabold tracking-wider text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full border border-indigo-200">
                    Questions & Answers
                </span>
                <h2 class="text-2xl md:text-3xl font-black text-slate-900 mt-2">
                    Frequently Asked Questions (FAQ)
                </h2>
                <p class="text-slate-500 text-sm mt-1">Everything you need to know about 100KB PDF compression</p>
            </div>

            <div class="space-y-4">
                {faqSchema.mainEntity.map((item) => (
                    <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
                        <h3 class="font-bold text-slate-900 text-base mb-2">{item.name}</h3>
                        <p class="text-slate-600 text-sm leading-relaxed">{item.acceptedAnswer.text}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <CookieBanner client:idle dict={dict} slot="cookie-banner" />
</Layout>
