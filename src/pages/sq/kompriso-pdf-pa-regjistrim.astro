---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import { getDictionary } from '../../i18n/dictionary';
import Navbar from '../../components/landing/Navbar';
import CookieBanner from '../../components/landing/CookieBanner';
import CompressClient from '../../components/tools/CompressClient';

const lang = 'sq';
const dict = getDictionary(lang);

const seoTitle = "Kompriso PDF pa Regjistrim — Zvogëlo PDF Falas Online | KeepPDF";
const seoDescription = "Kompriso PDF pa regjistrim dhe pa ngarkim në server. Zvogëloni madhësinë e skedarit PDF falas — shpejt, sigurt, 100% në shfletues.";

const howToSchema = {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "Si të Kompresosh PDF Falas në 3 Hapa",
    "description": "Kompriso PDF pa regjistrim me KeepPDF — thjesht dhe shpejt.",
    "step": [
        {
            "@type": "HowToStep",
            "position": 1,
            "name": "Ngarkoni PDF-në",
            "text": "Zgjidhni ose zvarritni skedarin PDF që dëshironi të kompresoni."
        },
        {
            "@type": "HowToStep",
            "position": 2,
            "name": "Zgjidhni Cilësinë",
            "text": "Zgjidhni kompresim bazë (cilësi e lartë) ose të fortë (madhësi minimale)."
        },
        {
            "@type": "HowToStep",
            "position": 3,
            "name": "Shkarkoni",
            "text": "Klikoni \"Kompriso\" dhe shkarkoni PDF-në e zvogëluar menjëherë — falas!"
        }
    ]
};

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
        {
            "@type": "Question",
            "name": "A humb cilësinë kur kompriso PDF?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Kompresimi bazë ruan cilësinë e lartë. Kompresimi i fortë zvogëlon më shumë por mund të ndikojë pak."
            }
        },
        {
            "@type": "Question",
            "name": "A duhet regjistrim?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Jo! Kompriso PDF pa regjistrim — nuk nevojitet llogari."
            }
        },
        {
            "@type": "Question",
            "name": "Sa mund ta zvogëloj madhësinë?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Bazë: 20-40%, fortë: deri 80%."
            }
        }
    ]
};
---

<Layout lang={lang} dict={dict} title={seoTitle} description={seoDescription}>
    <Navbar client:load lang={lang} dict={dict} slot="navbar" />

    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <!-- Hreflang -->
    <link rel="alternate" hreflang="en" href={"https://keep-pdf.com/en/compress"} />
    <link rel="alternate" hreflang="tr" href={"https://keep-pdf.com/tr/compress"} />
    <link rel="alternate" hreflang="sq" href={"https://keep-pdf.com/sq/kompriso-pdf-pa-regjistrim"} />
    <link rel="alternate" hreflang="et" href={"https://keep-pdf.com/et/tihenda-pdf-tasuta"} />
    <link rel="alternate" hreflang="lv" href={"https://keep-pdf.com/lv/saspiest-pdf-bezmaksas"} />
    <link rel="alternate" hreflang="x-default" href={"https://keep-pdf.com/en/compress"} />

    <!-- Hero Section -->
    <section class="relative overflow-hidden pt-24 pb-16" style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%);">
        <div class="absolute inset-0 opacity-10">
            <div class="absolute top-20 left-10 w-72 h-72 bg-purple-400 rounded-full filter blur-3xl animate-pulse"></div>
            <div class="absolute bottom-10 right-20 w-96 h-96 bg-indigo-400 rounded-full filter blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
        </div>
        <div class="container-custom max-w-4xl mx-auto relative z-10 text-center px-4">
            <span class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm text-white/90 text-sm font-medium px-4 py-2 rounded-full border border-white/20 mb-6">
                🔒 100% private — skedarët nuk largohen nga shfletuesi juaj
            </span>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6" style="letter-spacing: -0.03em;">
                Kompriso PDF pa Regjistrim
                <span class="block text-indigo-300 text-2xl md:text-3xl font-semibold mt-3">Zvogëlo Madhësinë e PDF — Falas dhe pa Server</span>
            </h1>
            <div class="flex flex-wrap justify-center gap-4 mb-8">
                <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm px-4 py-2 rounded-xl text-white/80 text-sm">
                    <span class="text-green-400">✓</span> Falas përgjithmonë
                </div>
                <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm px-4 py-2 rounded-xl text-white/80 text-sm">
                    <span class="text-green-400">✓</span> Pa regjistrim
                </div>
                <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm px-4 py-2 rounded-xl text-white/80 text-sm">
                    <span class="text-green-400">✓</span> Pa ngarkim në server
                </div>
            </div>
        </div>
    </section>

    <!-- Tool -->
    <section class="py-12 bg-slate-50">
        <div class="container-custom max-w-4xl mx-auto px-4">
    <CompressClient client:load dict={dict} />
        </div>
    </section>

    <!-- How To Section -->
    <section class="py-20 bg-white">
        <div class="container-custom max-w-5xl mx-auto px-4">
            <div class="text-center mb-14">
                <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-4">Si të Kompresosh PDF Falas në 3 Hapa</h2>
                <p class="text-lg text-slate-500 max-w-2xl mx-auto">Kompriso PDF pa regjistrim me KeepPDF — thjesht dhe shpejt.</p>
            </div>
            <div class="grid md:grid-cols-3 gap-8">
                <div class="relative bg-gradient-to-br from-indigo-50 to-white rounded-2xl p-8 border border-indigo-100 shadow-sm hover:shadow-lg transition-shadow">
                    <div class="absolute -top-4 -left-4 w-12 h-12 bg-indigo-600 text-white rounded-xl flex items-center justify-center text-lg font-bold shadow-lg">1</div>
                    <div class="text-4xl mb-4 mt-2">📂</div>
                    <h3 class="text-lg font-bold text-slate-900 mb-2">Ngarkoni PDF-në</h3>
                    <p class="text-slate-500 text-sm leading-relaxed">Zgjidhni ose zvarritni skedarin PDF që dëshironi të kompresoni.</p>
                </div>
                <div class="relative bg-gradient-to-br from-purple-50 to-white rounded-2xl p-8 border border-purple-100 shadow-sm hover:shadow-lg transition-shadow">
                    <div class="absolute -top-4 -left-4 w-12 h-12 bg-purple-600 text-white rounded-xl flex items-center justify-center text-lg font-bold shadow-lg">2</div>
                    <div class="text-4xl mb-4 mt-2">⚙️</div>
                    <h3 class="text-lg font-bold text-slate-900 mb-2">Zgjidhni Cilësinë</h3>
                    <p class="text-slate-500 text-sm leading-relaxed">Zgjidhni kompresim bazë (cilësi e lartë) ose të fortë (madhësi minimale).</p>
                </div>
                <div class="relative bg-gradient-to-br from-emerald-50 to-white rounded-2xl p-8 border border-emerald-100 shadow-sm hover:shadow-lg transition-shadow">
                    <div class="absolute -top-4 -left-4 w-12 h-12 bg-emerald-600 text-white rounded-xl flex items-center justify-center text-lg font-bold shadow-lg">3</div>
                    <div class="text-4xl mb-4 mt-2">⬇️</div>
                    <h3 class="text-lg font-bold text-slate-900 mb-2">Shkarkoni</h3>
                    <p class="text-slate-500 text-sm leading-relaxed">Klikoni "Kompriso" dhe shkarkoni PDF-në e zvogëluar menjëherë — falas!</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Why Section -->
    <section class="py-20 bg-slate-50">
        <div class="container-custom max-w-5xl mx-auto px-4">
            <div class="text-center mb-14">
                <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-4">Pse të Kompresosh PDF me KeepPDF?</h2>
                <p class="text-lg text-slate-500 max-w-2xl mx-auto">Arsyet pse KeepPDF është zgjedhja më e mirë</p>
            </div>
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
                <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition-shadow text-center">
                    <div class="text-3xl mb-3">🔒</div>
                    <h3 class="font-bold text-slate-900 mb-2">100% Privat</h3>
                    <p class="text-sm text-slate-500">Skedarët nuk ngarkohen kurrë në server.</p>
                </div>
                <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition-shadow text-center">
                    <div class="text-3xl mb-3">⚡</div>
                    <h3 class="font-bold text-slate-900 mb-2">Rezultate të Shpejta</h3>
                    <p class="text-sm text-slate-500">Zvogëloni PDF brenda sekondave.</p>
                </div>
                <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition-shadow text-center">
                    <div class="text-3xl mb-3">💰</div>
                    <h3 class="font-bold text-slate-900 mb-2">Pa Regjistrim</h3>
                    <p class="text-sm text-slate-500">Nuk kërkohet llogari.</p>
                </div>
                <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition-shadow text-center">
                    <div class="text-3xl mb-3">📱</div>
                    <h3 class="font-bold text-slate-900 mb-2">Çdo Pajisje</h3>
                    <p class="text-sm text-slate-500">Punon në kompjuter, telefon dhe tablet.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-20 bg-white">
        <div class="container-custom max-w-3xl mx-auto px-4">
            <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 text-center mb-12">Si të Kompresosh PDF Falas në FAQ</h2>
            <div class="space-y-4">
                <details class="group bg-slate-50 rounded-xl border border-slate-200 overflow-hidden">
                    <summary class="flex items-center justify-between p-6 cursor-pointer font-semibold text-slate-900 hover:bg-slate-100 transition-colors">
                        A humb cilësinë kur kompriso PDF?
                        <span class="text-indigo-500 group-open:rotate-45 transition-transform text-xl">+</span>
                    </summary>
                    <div class="px-6 pb-6 text-slate-600 leading-relaxed">Kompresimi bazë ruan cilësinë e lartë. Kompresimi i fortë zvogëlon më shumë por mund të ndikojë pak.</div>
                </details>
                <details class="group bg-slate-50 rounded-xl border border-slate-200 overflow-hidden">
                    <summary class="flex items-center justify-between p-6 cursor-pointer font-semibold text-slate-900 hover:bg-slate-100 transition-colors">
                        A duhet regjistrim?
                        <span class="text-indigo-500 group-open:rotate-45 transition-transform text-xl">+</span>
                    </summary>
                    <div class="px-6 pb-6 text-slate-600 leading-relaxed">Jo! Kompriso PDF pa regjistrim — nuk nevojitet llogari.</div>
                </details>
                <details class="group bg-slate-50 rounded-xl border border-slate-200 overflow-hidden">
                    <summary class="flex items-center justify-between p-6 cursor-pointer font-semibold text-slate-900 hover:bg-slate-100 transition-colors">
                        Sa mund ta zvogëloj madhësinë?
                        <span class="text-indigo-500 group-open:rotate-45 transition-transform text-xl">+</span>
                    </summary>
                    <div class="px-6 pb-6 text-slate-600 leading-relaxed">Bazë: 20-40%, fortë: deri 80%.</div>
                </details>
            </div>
        </div>
    </section>

    <!-- Internal Links -->
    <section class="py-16 bg-indigo-50">
        <div class="container-custom max-w-4xl mx-auto px-4 text-center">
            <div class="flex flex-wrap justify-center gap-4">
                <a href="/sq/bashko-pdf-falas" class="inline-flex items-center gap-2 bg-white text-indigo-700 font-semibold px-6 py-3 rounded-xl border border-indigo-200 hover:border-indigo-400 hover:shadow-md transition-all text-sm">
                    🔗 Bashko PDF Falas
                </a>
                <a href="/sq/ndaj-pdf-falas-online" class="inline-flex items-center gap-2 bg-white text-indigo-700 font-semibold px-6 py-3 rounded-xl border border-indigo-200 hover:border-indigo-400 hover:shadow-md transition-all text-sm">
                    ✂️ Ndaj PDF Falas
                </a>
                <a href="/sq/compress" class="inline-flex items-center gap-2 bg-white text-indigo-700 font-semibold px-6 py-3 rounded-xl border border-indigo-200 hover:border-indigo-400 hover:shadow-md transition-all text-sm">
                    🔧 Mjeti i Kompresimit
                </a>
            </div>
        </div>
    </section>

    <CookieBanner client:load dict={dict} slot="cookie-banner" />
</Layout>
