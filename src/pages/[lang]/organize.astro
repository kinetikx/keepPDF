---
import Layout from '../../layouts/Layout.astro';
import { getDictionary, locales } from '../../i18n/dictionary';
import Navbar from '../../components/landing/Navbar';
import CookieBanner from '../../components/landing/CookieBanner';
import OrganizeClient from '../../components/tools/OrganizeClient';
import HowToSection from "../../components/tools/HowToSection";
import UseCaseSection from '../../components/tools/UseCaseSection';

export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
const dict = getDictionary(lang);
---

<Layout lang={lang} dict={dict} title={dict.metadata.organize.title} description={dict.metadata.organize.description}>
  <Navbar client:load lang={lang} dict={dict} slot="navbar" />
  <OrganizeClient client:load dict={dict} />
  <HowToSection client:visible slug="organize" lang={lang} />
  <UseCaseSection client:visible slug="organize" lang={lang} />
  <CookieBanner client:load dict={dict} slot="cookie-banner" />
</Layout>
