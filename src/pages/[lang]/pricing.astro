    competitorTitle: "Traditional Cloud Competitors",
    competitorSubtitle: "Smallpdf, iLovePDF, Adobe Acrobat",
    competitorPrice: "$6 - $12",
    competitorPriceSub: "/ month",
    competitorFeatures: [
