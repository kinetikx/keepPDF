const current = pricingData[lang] || pricingData.en;
---

<Layout
  lang={lang}
  dict={dict}
  title={current.metaTitle}
  description={current.metaDesc}
>
  <Navbar client:idle lang={lang} dict={dict} slot="navbar" />

  <!-- Hero Header -->
  <section class="relative py-20 bg-gradient-to-b from-white via-indigo-50/40 to-white overflow-hidden text-center">
    <div class="container-custom max-w-4xl mx-auto px-4 relative z-10">
      <span class="inline-block px-4 py-1.5 bg-emerald-100 text-emerald-800 text-xs sm:text-sm font-bold rounded-full mb-6 uppercase tracking-wider">
        {current.freeBadge}
      </span>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-slate-900 tracking-tight mb-6 leading-tight">
        {current.h1}
      </h1>
      <p class="text-lg sm:text-xl text-slate-500 max-w-2xl mx-auto leading-relaxed">
        {current.subtitle}
      </p>
    </div>
  </section>

  <!-- Pricing Cards Comparison -->
  <section class="py-12 bg-white">
    <div class="container-custom max-w-5xl mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
        
        {/* KeepPDF Free Card */}
        <div class="relative bg-gradient-to-b from-indigo-900 via-slate-900 to-indigo-950 text-white rounded-3xl p-8 sm:p-10 shadow-2xl flex flex-col justify-between border-2 border-indigo-500/50">
          <div class="absolute -top-3.5 right-8 bg-emerald-500 text-white text-xs font-bold uppercase tracking-wider px-3.5 py-1 rounded-full shadow-md">
            Recommended
          </div>
          <div>
            <h3 class="text-2xl font-bold mb-2">KeepPDF</h3>
            <p class="text-slate-300 text-sm mb-6">{current.freeTitle}</p>
            <div class="flex items-baseline gap-2 mb-8">
              <span class="text-5xl sm:text-6xl font-extrabold tracking-tight text-white">{current.freePrice}</span>
              <span class="text-slate-400 text-sm font-medium">{current.freePriceSub}</span>
            </div>
            <ul class="space-y-4 mb-8">
              {current.freeFeatures.map(feat => (
                <li class="flex items-start gap-3 text-sm text-slate-200">
                  <span class="text-emerald-400 font-bold shrink-0">✓</span>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>
          <a
            href={`/${lang}`}
            class="w-full text-center py-4 bg-indigo-600 hover:bg-indigo-500 active:scale-95 text-white font-bold rounded-xl shadow-lg transition-all"
          >
            {current.ctaBtn}
          </a>
        </div>

        {/* Traditional Competitors Card */}
        <div class="bg-slate-50 border border-slate-200 rounded-3xl p-8 sm:p-10 flex flex-col justify-between text-slate-700">
          <div>
            <h3 class="text-2xl font-bold text-slate-900 mb-2">{current.competitorTitle}</h3>
            <p class="text-slate-500 text-sm mb-6">{current.competitorSubtitle}</p>
            <div class="flex items-baseline gap-2 mb-8">
              <span class="text-4xl sm:text-5xl font-bold tracking-tight text-slate-500 line-through opacity-70">{current.competitorPrice}</span>
              <span class="text-slate-500 text-sm">{current.competitorPriceSub}</span>
            </div>
            <ul class="space-y-4 mb-8">
              {current.competitorFeatures.map(feat => (
                <li class="flex items-start gap-3 text-sm text-slate-500">
                  <span class="text-rose-500 font-bold shrink-0">✗</span>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="text-center py-3 bg-slate-200/60 rounded-xl text-xs font-semibold text-slate-500 uppercase tracking-wide">
            Not Recommended
          </div>
        </div>

      </div>
    </div>
  </section>

  {/* Why is it free Section */}
  <section class="py-16 bg-slate-50 border-t border-slate-200">
    <div class="container-custom max-w-4xl mx-auto px-4 text-center">
      <div class="w-12 h-12 rounded-2xl bg-indigo-100 text-indigo-600 flex items-center justify-center mx-auto mb-4 text-2xl font-bold">
        💡
      </div>
      <h2 class="text-3xl font-extrabold text-slate-900 mb-4 tracking-tight">
        {current.whyFreeTitle}
      </h2>
      <p class="text-slate-600 text-base sm:text-lg leading-relaxed max-w-3xl mx-auto">
        {current.whyFreeDesc}
      </p>
    </div>
  </section>

  {/* FAQs */}
  <section class="py-16 bg-white border-t border-slate-200">
    <div class="container-custom max-w-3xl mx-auto px-4">
      <h2 class="text-3xl font-extrabold text-slate-900 mb-8 text-center tracking-tight">
        Frequently Asked Questions
      </h2>
      <div class="space-y-4">
        {current.faqs.map(faq => (
          <div class="p-6 rounded-2xl border border-slate-200 bg-slate-50/50">
            <h3 class="text-lg font-bold text-slate-900 mb-2">{faq.q}</h3>
            <p class="text-slate-600 text-sm leading-relaxed">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CookieBanner client:idle dict={dict} slot="cookie-banner" />
</Layout>
