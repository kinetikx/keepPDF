    competitorPrice: "6 - 12 €",
    competitorPriceSub: "/ në muaj",
    competitorFeatures: [
      "Limit i rreptë prej 2 skedarësh në ditë",
      "Dokumentet ngarkohen në serverë të panjohur",
      "Kërkojnë pagesë për kompresim cilësor",
      "Kërkesa të vazhdueshme për kartë krediti"
    ],
    whyFreeTitle: "Pse është KeepPDF tërësisht falas?",
    whyFreeDesc: "Përpunimi i PDF-ve bëhet lokalisht në pajisjen tuaj me WebAssembly, duke eliminuar shpenzimet e mëdha të serverëve.",
