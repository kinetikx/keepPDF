      },
      {
        q: "İleride ücretli abonelik gelecek mi?",
        a: "Hayır. PDF birleştirme, sıkıştırma ve bölme gibi temel araçlarımız sonsuza dek ücretsiz ve sınırsız kalacaktır."
      },
      {
        q: "Ticari veya resmi evraklar için kullanmak güvenli mi?",
        a: "Evet. Dosyalarınız cihazınızdan dışarı çıkmadığı için KVKK ve şirket gizlilik standartlarına %100 uygundur."
      }
    ]
  },
  sq: {
    metaTitle: "Çmimet e KeepPDF — Mjete PDF 100% Falas pa Kufizime",
    metaDesc: "Zbuloni modelin falas të KeepPDF. Pa pagesa mujore, pa kartë krediti dhe me privatësi maksimale.",
    h1: "E Thjeshtë, Transparente dhe 100% Falas Përgjithmonë",
    subtitle: "Pa kosto të fshehura, pa abonime mujore dhe pa kërkesë për kartë krediti.",
    freeBadge: "Falas Përgjithmonë",
