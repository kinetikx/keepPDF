    metaTitle: "KeepPDF Hinnad — 100% Tasuta PDF-tööriistad Ilma Piiranguteta",
    metaDesc: "KeepPDF on täiesti tasuta. Puuduvad kuutasud, krediitkaardi nõuded ja failipiirangud.",
    h1: "Lihtne, Läbipaistev ja 100% Tasuta",
    subtitle: "Ei mingeid varjatud kulusid ega kuutasusid. Loodud kõigile mugavaks kasutamiseks.",
    freeBadge: "Alati Tasuta",
    freeTitle: "Täisversioon kõigile",
    freePrice: "0 €",
    freePriceSub: "/ alati",
    freeFeatures: [
      "Piiranguteta PDF-ide liitmine, tükeldamine ja tihendamine",
      "100% Privaatne veebilehitsejas (ei laadita serverisse)",
      "Päevalimiidid puuduvad",
      "Dokumentidele ei lisata vesimärke",
      "Ei vaja registreerumist ega sisselogimist"
    ],
    competitorTitle: "Tavalised Pilveteenused",
    competitorSubtitle: "Smallpdf, iLovePDF, Adobe Acrobat",
    competitorPrice: "6 - 12 €",
    competitorPriceSub: "/ kuus",
    competitorFeatures: [
      "Ainult 1-2 tasuta faili päevas",
      "Dokumendid laaditakse kolmandate osapoolte serveritesse",
      "Pidev krediitkaardi andmete küsimine"
    ],
    whyFreeTitle: "Miks KeepPDF on tasuta?",
    whyFreeDesc: "Tänu WebAssembly tehnoloogiale toimub kogu failide töötlemine teie seadmes, säästes suuri serverikulusid.",
    ctaTitle: "Proovige tasuta tööriistu kohe",
    ctaBtn: "Kõik Tööriistad",
    faqs: [
      {
        q: "Kas siin on varjatud kulusid?",
        a: "Ei ole. Teenus on täiesti tasuta."
      }
    ]
  },
  lv: {
    metaTitle: "KeepPDF Cenas — 100% Bezmaksas PDF Rīki Bez Ierobežojumiem",
    metaDesc: "KeepPDF ir pilnībā bezmaksas. Bez abonementiem, bez kredītkartēm un ar 100% privātumu.",
    h1: "Vienkārši, Caurspīdīgi un 100% Bezmaksas",
    subtitle: "Nav slēptu izmaksu, abonēšanas maksu vai kredītkartes prasību.",
    freeBadge: "Vienmēr Bezmaksas",
    freeTitle: "Pilna Versija Visiem",
    freePrice: "0 €",
    freePriceSub: "/ vienmēr",
    freeFeatures: [
      "Neierobežota PDF apvienošana, sadalīšana un saspiešana",
      "100% Pārlūkprogrammas privātums (faili netiek augšupielādēti)",
      "Nav dienas limitu vai ierobežojumu",
      "Netiek pievienotas ūdenszīmes",
      "Nav nepieciešama reģistrācija"
    ],
    competitorTitle: "Mākoņpakalpojumu Konkurenti",
    competitorSubtitle: "Smallpdf, iLovePDF, Adobe Acrobat",
    competitorPrice: "6 - 12 €",
    competitorPriceSub: "/ mēnesī",
    competitorFeatures: [
      "Stingrs limits (1-2 faili dienā)",
      "Faili tiek nosūtīti uz ārējiem serveriem",
      "Nepārtraukti aicinājumi ievadīt maksājumu karti"
    ],
    whyFreeTitle: "Kāpēc KeepPDF ir bezmaksas?",
    whyFreeDesc: "KeepPDF apstrādā failus tieši jūsu datorā ar WebAssembly, tādēļ mums nav lielu serveru uzturēšanas izmaksu.",
    ctaTitle: "Sāciet lietot bezmaksas rīkus tagad",
    ctaBtn: "Visi Rīki",
    faqs: [
      {
        q: "Vai ir kādi slēpti maksājumi?",
        a: "Nē, pakalpojums ir pilnīgi bez maksas."
      }
    ]
  },
  id: {
    metaTitle: "Biaya & Harga KeepPDF — 100% Alat PDF Gratis Tanpa Batasan",
    metaDesc: "Pelajari model 100% gratis KeepPDF. Tanpa biaya langganan, tanpa kartu kredit, tanpa limit harian, dan privasi penuh di browser.",
    h1: "Sederhana, Transparan, dan 100% Gratis Selamanya",
    subtitle: "Tanpa biaya tersembunyi, tanpa langganan bulanan, dan tanpa kartu kredit. KeepPDF dibuat untuk semua orang.",
    freeBadge: "Gratis Selamanya",
    freeTitle: "Edisi Komunitas & Pribadi",
    freePrice: "Rp 0",
    freePriceSub: "/ selamanya",
    freeFeatures: [
      "Penggabungan, pemisahan, dan kompresi PDF tanpa batas",
      "100% Privasi di peramban (tanpa pernah diunggah ke server)",
      "Tanpa batasan jumlah dokumen atau tugas harian",
      "Tanpa watermark (tanda air) pada dokumen hasil olahan",
      "Kecepatan pemrosesan lokal berbasis WebAssembly",
      "Tanpa perlu registrasi email atau membuat akun"
    ],
    competitorTitle: "Layanan Cloud Tradisional",
    competitorSubtitle: "Smallpdf, iLovePDF, Adobe Acrobat",
    competitorPrice: "Rp 90.000 - Rp 180.000",
    competitorPriceSub: "/ bulan",
    competitorFeatures: [
      "Batas ketat 1-2 dokumen gratis per hari",
      "Dokumen diunggah dan disimpan di server pihak ketiga",
      "Mode kompresi tinggi dikunci di balik sistem bayar",
      "Muncul pop-up penagihan kartu kredit secara agresif",
      "Wajib registrasi akun dan pelacakan email"
    ],
    whyFreeTitle: "Mengapa KeepPDF sepenuhnya gratis?",
    whyFreeDesc: "Layanan cloud tradisional menyewa ratusan server backend yang mahal untuk memproses file Anda. Sebaliknya, KeepPDF memanfaatkan teknologi WebAssembly dan Web Workers modern langsung di perangkat Anda. Biaya operasional server kami mendekati nol, memungkinkan kami menyediakan KeepPDF 100% gratis dan privat selamanya.",
    ctaTitle: "Mulai olah dokumen PDF Anda secara gratis sekarang",
    ctaBtn: "Jelajahi Semua Alat Gratis",
    faqs: [
      {
        q: "Apakah ada biaya tersembunyi atau tagihan otomatis?",
        a: "Sama sekali tidak ada. Kami tidak pernah meminta informasi kartu kredit atau detail pembayaran Anda."
      },
      {
        q: "Apakah ada batasan berapa banyak PDF yang bisa saya proses per hari?",
        a: "Tidak ada limit harian. Anda dapat mengompres, menggabung, atau memisahkan dokumen sebanyak yang Anda butuhkan."
      },
      {
        q: "Apakah KeepPDF menambahkan watermark ke dokumen saya?",
        a: "Tidak. Dokumen hasil olahan Anda tetap bersih 100% tanpa tanda air apa pun."
      }
