    whyFreeDesc: "Unlike older services that run hundreds of costly backend servers to process your files in the cloud, KeepPDF utilizes cutting-edge WebAssembly (Wasm) and Web Workers. All PDF computation happens right inside your browser on your own device. This eliminates massive server infrastructure costs and allows us to keep KeepPDF completely free, sustainable, and 100% private forever.",
    ctaTitle: "Ready to get started with fast, free PDF tools?",
    ctaBtn: "Explore All Free Tools",
    faqs: [
      {
        q: "Are there any hidden fees or automatic renewals?",
        a: "None whatsoever. KeepPDF does not ask for your credit card, billing address, or payment information. There are zero subscriptions."
      },
      {
        q: "Will KeepPDF introduce paid paywalls in the future?",
        a: "No. Our core tools—merging, splitting, compressing, and organizing PDFs—will remain completely free and unlimited forever."
      },
      {
        q: "Is it safe to use KeepPDF for sensitive business and legal documents?",
        a: "Yes! Because KeepPDF processes everything locally on your computer or phone, confidential contracts, bank statements, and personal records never leave your machine."
      }
    ]
  },
  tr: {
    metaTitle: "KeepPDF Fiyatlandırma — %100 Ücretsiz ve Limitsiz PDF Araçları",
    metaDesc: "KeepPDF'in tamamen ücretsiz modelini keşfedin. Abonelik yok, kredi kartı yok, günlük görev sınırı yok ve %100 yerel gizlilik.",
