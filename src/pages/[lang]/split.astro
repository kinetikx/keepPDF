---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import { getDictionary, locales } from '../../i18n/dictionary';
import Navbar from '../../components/landing/Navbar';
import CookieBanner from '../../components/landing/CookieBanner';
import SplitClient from '../../components/tools/SplitClient';
import UseCaseSection from '../../components/tools/UseCaseSection';
import HowToSection from '../../components/tools/HowToSection';

import { buildHowToSchema } from '../../data/howTo';
export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
const dict = getDictionary(lang);
const howToSchema = buildHowToSchema('split', lang);
---

<Layout lang={lang} dict={dict} title={dict.metadata.split.title} description={dict.metadata.split.description} howToSchema={howToSchema}>
  <Navbar client:load lang={lang} dict={dict} slot="navbar" />
  <SplitClient client:load dict={dict} />
  <HowToSection client:visible slug="split" lang={lang} />
  <UseCaseSection client:visible slug="split" lang={lang} />
  <CookieBanner client:load dict={dict} slot="cookie-banner" />
</Layout>

