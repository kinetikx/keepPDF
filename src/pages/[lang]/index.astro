---
import Layout from '../../layouts/Layout.astro';
import { getDictionary, locales } from '../../i18n/dictionary';
import Navbar from '../../components/landing/Navbar';
import MergeInterface from '../../components/landing/MergeInterface';
import FAQSection from '../../components/landing/FAQSection';
import CookieBanner from '../../components/landing/CookieBanner';
import TrustBanner from '../../components/landing/TrustBanner';
import { Shield, Zap, Gift, FileText, Scissors, Minimize2, Image, FileType, PenTool, ScanLine, FileSpreadsheet, Files } from 'lucide-react';

export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
const dict = getDictionary(lang);

const tools = [
  { icon: 'LayoutTemplate', title: dict.tools.split.title, desc: dict.tools.split.description, href: `/${lang}/split`, lightColor: 'bg-orange-50 text-orange-600' },
  { icon: 'Minimize2', title: dict.tools.compress.title, desc: dict.tools.compress.description, href: `/${lang}/compress`, lightColor: 'bg-red-50 text-red-600' },
  { icon: 'Files', title: dict.tools.organize.title, desc: dict.tools.organize.description, href: `/${lang}/organize`, lightColor: 'bg-purple-50 text-purple-600' },
  { icon: 'Image', title: dict.tools.imageToPdf.title, desc: dict.tools.imageToPdf.description, href: `/${lang}/image-to-pdf`, lightColor: 'bg-blue-50 text-blue-600' },
  { icon: 'FileText', title: dict.tools.pdfToWord.title, desc: dict.tools.pdfToWord.description, href: `/${lang}/pdf-to-word`, lightColor: 'bg-blue-50 text-blue-600' },
  { icon: 'FileText', title: dict.tools.wordToPdf.title, desc: dict.tools.wordToPdf.description, href: `/${lang}/word-to-pdf`, lightColor: 'bg-blue-50 text-blue-600' },
  { icon: 'FileSpreadsheet', title: dict.tools.pdfToImage.title, desc: dict.tools.pdfToImage.description, href: `/${lang}/pdf-to-image`, lightColor: 'bg-pink-50 text-pink-600' },
  { icon: 'Files', title: dict.tools.merge.title, desc: dict.tools.merge.description, href: `/${lang}/merge-pdf`, lightColor: 'bg-pink-50 text-pink-600' },
  { icon: 'PenTool', title: dict.tools.sign.title, desc: dict.tools.sign.description, href: `/${lang}/sign-pdf`, lightColor: 'bg-purple-50 text-purple-600', comingSoon: true },
  { icon: 'LayoutTemplate', title: dict.tools.edit.title, desc: dict.tools.edit.description, href: `/${lang}/edit-pdf`, lightColor: 'bg-cyan-50 text-cyan-600', comingSoon: true },
  { icon: 'FileCode', title: dict.tools.pdfToTxt.title, desc: dict.tools.pdfToTxt.description, href: `/${lang}/pdf-to-txt`, lightColor: 'bg-orange-50 text-orange-600', comingSoon: true },
  { icon: 'FileSpreadsheet', title: dict.tools.pdfToExcel.title, desc: dict.tools.pdfToExcel.description, href: `/${lang}/pdf-to-excel`, lightColor: 'bg-green-50 text-green-600', comingSoon: true },
  { icon: 'ScanLine', title: dict.tools.ocr.title, desc: dict.tools.ocr.description, href: `/${lang}/ocr-pdf`, lightColor: 'bg-indigo-50 text-indigo-600', comingSoon: true },
];

const whyFeatures = [
  { icon: 'Shield', title: dict.why.secure.title, desc: dict.why.secure.description, color: 'text-brand-600' },
  { icon: 'Zap', title: dict.why.fast.title, desc: dict.why.fast.description, color: 'text-amber-500' },
  { icon: 'Gift', title: dict.why.free.title, desc: dict.why.free.description, color: 'text-green-500' },
];
---

<Layout 
  lang={lang} 
  dict={dict} 
  title={dict.metadata.title} 
  description={dict.metadata.description}
>
  <Navbar client:load lang={lang} dict={dict} slot="navbar" />
  
  <!-- Hero Section -->
  <section class="relative py-20 bg-gradient-to-b from-white via-indigo-50/30 to-white overflow-hidden">
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <div class="absolute -top-40 -right-40 w-96 h-96 bg-brand-100/30 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-indigo-100/20 rounded-full blur-3xl"></div>
    </div>
    <div class="container-custom text-center mb-12 relative z-10">
      <h1 class="text-5xl md:text-6xl font-extrabold tracking-tight text-slate-900 mb-6 leading-tight">
        {dict.hero.title}
      </h1>
      <p class="text-xl text-slate-500 max-w-2xl mx-auto leading-relaxed mb-8">
        {dict.hero.description}
      </p>
    </div>
    <MergeInterface client:load dict={dict} />
  </section>

  <TrustBanner client:load dict={dict} />

  <!-- Tools Grid -->
  <section class="py-20 bg-slate-50/50">
    <div class="container-custom">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {tools.map((tool) => (
          <a href={tool.href} class={`group relative bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-xl hover:shadow-brand-500/5 hover:-translate-y-1 transition-all duration-300 cursor-pointer ${tool.comingSoon ? 'opacity-80' : ''}`}>
            {tool.comingSoon && (
              <span class="absolute top-4 right-4 bg-amber-100 text-amber-700 text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wider">
                {dict.common.comingSoon}
              </span>
            )}
            <div class={`w-12 h-12 rounded-xl ${tool.lightColor} flex items-center justify-center mb-6`}>
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                {tool.icon === 'Files' && <><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></>}
                {tool.icon === 'LayoutTemplate' && <><rect width="18" height="7" x="3" y="3" rx="1"/><rect width="9" height="7" x="3" y="14" rx="1"/><rect width="5" height="7" x="16" y="14" rx="1"/></>}
                {tool.icon === 'Minimize2' && <><polyline points="4 14 10 14 10 20"/><polyline points="20 10 14 10 14 4"/><line x1="14" y1="10" x2="21" y2="3"/><line x1="3" y1="21" x2="10" y2="14"/></>}
                {tool.icon === 'Image' && <><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></>}
                {tool.icon === 'FileText' && <><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></>}
                {tool.icon === 'FileSpreadsheet' && <><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M8 13h2"/><path d="M14 13h2"/><path d="M8 17h2"/><path d="M14 17h2"/></>}
                {tool.icon === 'PenTool' && <><path d="m12 19 7-7 3 3-7 7-3-3z"/><path d="m18 13-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="m2 2 7.586 7.586"/><circle cx="11" cy="11" r="2"/></>}
                {tool.icon === 'FileCode' && <><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="m10 13-2 2 2 2"/><path d="m14 17 2-2-2-2"/></>}
                {tool.icon === 'ScanLine' && <><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><line x1="7" y1="12" x2="17" y2="12"/></>}
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-brand-600 transition-colors">
              {tool.title}
            </h3>
            <p class="text-sm text-slate-500 mb-4 leading-relaxed line-clamp-2">{tool.desc}</p>
            <div class="flex items-center text-sm font-medium text-slate-400 group-hover:text-brand-600 transition-colors">
              {tool.comingSoon ? dict.common.comingSoon : tool.title}
              <svg class="w-3.5 h-3.5 ml-1 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Section -->
  <section class="py-20 bg-slate-50">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl mb-4">{dict.why.title}</h2>
        <p class="text-slate-500 text-lg max-w-3xl mx-auto">{dict.why.description}</p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        {whyFeatures.map((feature) => (
          <div class="bg-white rounded-2xl p-8 text-center border border-slate-200 shadow-sm hover:shadow-lg transition-shadow">
            <div class={`w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-6 ${feature.color === 'text-brand-600' ? 'bg-brand-50' : feature.color === 'text-amber-500' ? 'bg-amber-50' : 'bg-green-50'}`}>
              <svg class={`w-8 h-8 ${feature.color}`} fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                {feature.icon === 'Shield' && <><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></>}
                {feature.icon === 'Zap' && <><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></>}
                {feature.icon === 'Gift' && <><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"/></>}
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">{feature.title}</h3>
            <p class="text-slate-500 leading-relaxed">{feature.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <FAQSection client:visible dict={dict} />

  <CookieBanner client:load dict={dict} slot="cookie-banner" />
</Layout>
