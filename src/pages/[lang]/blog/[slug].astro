---
export const prerender = false;
import BlogPostLayout from '../../../layouts/BlogPostLayout.astro';
import { getDictionary, languageRegistry } from '../../../i18n/dictionary';
import { getCollection, render } from 'astro:content';
import Navbar from '../../../components/landing/Navbar';
import CookieBanner from '../../../components/landing/CookieBanner';
import { supabase } from '../../../lib/supabase';
import { marked } from 'marked';

const { lang, slug } = Astro.params;
const dict = getDictionary(lang);

// 1. Try fetching from Supabase first
let dbPost = null;
try {
    const { data } = await supabase
        .from('blog_posts')
        .select('*')
        .eq('lang', lang)
        .eq('slug', slug)
        .eq('is_published', true)
        .single();
    if (data) dbPost = data;
} catch (e) {
    console.error('Supabase post fetch error:', e);
}

// 2. If not found in Supabase, try local markdown content collection
let localPost = null;
let ContentComponent = null;
let htmlContent = '';

if (dbPost) {
    htmlContent = await marked.parse(dbPost.content || '');
} else {
    try {
        const allPosts = await getCollection('blog');
        localPost = allPosts.find(p => p.id === `${lang}/${slug}`);
        if (localPost) {
            const rendered = await render(localPost);
            ContentComponent = rendered.Content;
        }
    } catch (e) {
        console.error('Local collection post fetch error:', e);
    }
}

// 3. If post does not exist in either, 404
if (!dbPost && !localPost) {
    return Astro.redirect(`/${lang}/404`);
}

// 4. Unified post object
const post = dbPost ? {
    id: `${dbPost.lang}/${dbPost.slug}`,
    data: {
        title: dbPost.title,
        description: dbPost.description,
        date: new Date(dbPost.published_at || dbPost.created_at),
        author: dbPost.author || 'KeepPDF Team',
        tags: dbPost.tags || [],
        image: dbPost.cover_image || null,
        category: dbPost.category || 'Guides',
    },
    body: dbPost.content || ''
} : localPost;

const bodyText = typeof post.body === 'string' ? post.body : '';
const readingTime = Math.ceil(bodyText.split(/\s+/).length / 200);

// 5. Dynamic Translations & Related Posts
let translations = [];
let relatedPosts = [];

if (dbPost) {
    // Check if there are posts with the same slug or same category in other languages
    try {
        const { data: transData } = await supabase
            .from('blog_posts')
            .select('lang, slug')
            .eq('slug', slug)
            .neq('lang', lang)
            .eq('is_published', true);
        if (transData) translations = transData;

        const { data: relData } = await supabase
            .from('blog_posts')
            .select('*')
            .eq('lang', lang)
            .neq('slug', slug)
            .eq('is_published', true)
            .limit(3);
        if (relData) {
            relatedPosts = relData.map(p => ({
                id: `${p.lang}/${p.slug}`,
                slug: p.slug,
                data: {
                    title: p.title,
                    description: p.description,
                    category: p.category,
                    date: new Date(p.published_at || p.created_at)
                }
            }));
        }
    } catch (e) {}
} else if (localPost) {
    try {
        const allPosts = await getCollection('blog');
        const langPosts = allPosts.filter(p => p.id.startsWith(`${lang}/`) && p.id !== localPost.id);
        relatedPosts = langPosts.slice(0, 3).map(p => ({
            id: p.id,
            slug: p.id.replace(`${lang}/`, ''),
            data: p.data
        }));

        if (localPost.data.translationKey) {
            const translatedPosts = allPosts.filter(
                p => p.data.translationKey === localPost.data.translationKey && p.id !== localPost.id
            );
            translations = translatedPosts.map(p => {
                const tLang = p.id.split('/')[0];
                const tSlug = p.id.replace(`${tLang}/`, '');
                return { lang: tLang, slug: tSlug };
            });
        }
    } catch (e) {}
}
---

<BlogPostLayout lang={lang} dict={dict} post={post} translations={translations}>
    <Navbar client:load lang={lang} dict={dict} slot="navbar" />

    <article class="py-12">
        <div class="container-custom max-w-3xl mx-auto px-4">
            <!-- Breadcrumb -->
            <nav class="mb-8 text-sm">
                <ol class="flex items-center gap-2 text-slate-400">
                    <li><a href={`/${lang}`} class="hover:text-indigo-600 transition-colors">KeepPDF</a></li>
                    <li>/</li>
                    <li><a href={`/${lang}/blog`} class="hover:text-indigo-600 transition-colors">{dict?.blog?.title || "Blog"}</a></li>
                    <li>/</li>
                    <li class="text-slate-600 font-medium truncate max-w-[200px]">{post.data.title}</li>
                </ol>
            </nav>

            <!-- Header -->
            <header class="mb-10">
                <div class="flex items-center gap-3 mb-4">
                    <span class="text-xs font-semibold text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded-full uppercase tracking-wider">
                        {dict?.blog?.categories?.[post.data.category] || post.data.category}
                    </span>
                    <span class="text-sm text-slate-400">
                        {readingTime} {dict?.blog?.minRead || "min read"}
                    </span>
                </div>

                <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 leading-tight mb-4">
                    {post.data.title}
                </h1>

                <p class="text-lg text-slate-500 leading-relaxed mb-6">
                    {post.data.description}
                </p>

                <div class="flex items-center gap-4 text-sm text-slate-400 pb-6 border-b border-slate-100">
                    <span>{dict?.blog?.publishedOn || "Published on"} {post.data.date.toLocaleDateString(lang === 'tr' ? 'tr-TR' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
                    <span>•</span>
                    <span>{dict?.blog?.by || "by"} {post.data.author}</span>
                </div>
            </header>

            {post.data.image && (
                <div class="mb-10 rounded-2xl overflow-hidden shadow-lg">
                    <img
                        src={post.data.image}
                        alt={post.data.title}
                        class="w-full aspect-video object-cover"
                    />
                </div>
            )}

            <!-- Blog Content (Markdown or Rendered) -->
            <div class="prose prose-lg prose-slate max-w-none
                prose-headings:font-bold prose-headings:text-slate-900
                prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
                prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
                prose-p:text-slate-600 prose-p:leading-relaxed
                prose-a:text-indigo-600 prose-a:no-underline hover:prose-a:underline
                prose-strong:text-slate-800
                prose-li:text-slate-600
                prose-code:text-indigo-600 prose-code:bg-indigo-50 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
                prose-blockquote:border-l-indigo-500 prose-blockquote:bg-slate-50 prose-blockquote:py-1 prose-blockquote:px-6 prose-blockquote:rounded-r-lg
                prose-table:border prose-table:border-slate-200 prose-th:bg-slate-50 prose-td:border prose-td:border-slate-200 prose-th:border prose-th:border-slate-200 prose-th:px-4 prose-th:py-2 prose-td:px-4 prose-td:py-2
            ">
                {ContentComponent ? (
                    <ContentComponent />
                ) : (
                    <div set:html={htmlContent} />
                )}
            </div>

            <!-- Tags -->
            {post.data.tags && post.data.tags.length > 0 && (
                <div class="mt-10 pt-6 border-t border-slate-100">
                    <span class="text-sm font-semibold text-slate-500 mr-2">{dict?.blog?.tags || "Tags"}:</span>
                    <div class="inline-flex flex-wrap gap-2 mt-2">
                        {post.data.tags.map(tag => (
                            <span class="text-xs bg-slate-100 text-slate-600 px-3 py-1.5 rounded-full font-medium">
                                #{tag}
                            </span>
                        ))}
                    </div>
                </div>
            )}

            <!-- Translation Links -->
            {translations && translations.length > 0 && (
                <div class="mt-6 p-4 bg-indigo-50/50 rounded-xl border border-indigo-100">
                    <span class="text-sm text-indigo-600 font-medium">
                        🌐 {dict?.blog?.translationAvailable || 'This post is also available in:'}
                    </span>
                    <div class="flex flex-wrap gap-3 mt-2">
                        {translations.map(t => (
                            <a
                                href={`/${t.lang}/blog/${t.slug}`}
                                class="text-sm font-semibold text-indigo-600 hover:text-indigo-800 bg-white px-3 py-1.5 rounded-lg border border-indigo-200 hover:border-indigo-300 transition-colors"
                            >
                                {languageRegistry[t.lang]?.flag || ''} {languageRegistry[t.lang]?.name || t.lang.toUpperCase()}
                            </a>
                        ))}
                    </div>
                </div>
            )}

            <!-- Back to Blog -->
            <div class="mt-10">
                <a
                    href={`/${lang}/blog`}
                    class="inline-flex items-center gap-2 text-sm font-semibold text-indigo-600 hover:text-indigo-800 transition-colors"
                >
                    {dict?.blog?.backToBlog || "← Back to Blog"}
                </a>
            </div>

            <!-- Related Posts -->
            {relatedPosts && relatedPosts.length > 0 && (
                <section class="mt-16 pt-10 border-t border-slate-200">
                    <h2 class="text-2xl font-bold text-slate-900 mb-6">
                        {dict?.blog?.relatedPosts || "Related Posts"}
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        {relatedPosts.map(rp => (
                            <a
                                href={`/${lang}/blog/${rp.slug}`}
                                class="group p-5 rounded-xl border border-slate-200 hover:border-indigo-300 hover:shadow-md transition-all flex flex-col justify-between"
                            >
                                <div>
                                    <span class="text-xs text-indigo-600 font-semibold uppercase">
                                        {rp.data.category}
                                    </span>
                                    <h3 class="text-base font-bold text-slate-900 mt-2 group-hover:text-indigo-600 transition-colors line-clamp-2">
                                        {rp.data.title}
                                    </h3>
                                </div>
                                <span class="text-xs text-slate-400 mt-4 block">
                                    {rp.data.date?.toLocaleDateString?.(lang === 'tr' ? 'tr-TR' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                                </span>
                            </a>
                        ))}
                    </div>
                </section>
            )}
        </div>
    </article>

    <!-- Internal Links: Related PDF Tools (SEO + UX) -->
    <section class="py-12 bg-gradient-to-b from-slate-50 to-white border-t border-slate-100">
        <div class="container-custom max-w-3xl mx-auto px-4">
            <h2 class="text-xl font-bold text-slate-800 mb-2">
                🛠️ {dict?.blog?.freeTools || "Free PDF Tools"}
            </h2>
            <p class="text-sm text-slate-500 mb-6">
                {dict?.blog?.freeToolsDesc || "Try our free online PDF tools — no signup, no limits."}
            </p>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                {[
                    { href: `/${lang}/compress`, emoji: '📦', label: dict?.nav?.compress || 'Compress PDF' },
                    { href: `/${lang}/merge-pdf`, emoji: '🔗', label: dict?.nav?.merge || 'Merge PDF' },
                    { href: `/${lang}/split`, emoji: '✂️', label: dict?.nav?.split || 'Split PDF' },
                    { href: `/${lang}/pdf-to-word`, emoji: '📝', label: dict?.nav?.pdfToWord || 'PDF to Word' },
                    { href: `/${lang}/pdf-to-image`, emoji: '🖼️', label: dict?.nav?.pdfToImage || 'PDF to Image' },
                    { href: `/${lang}/edit-pdf`, emoji: '✏️', label: dict?.nav?.editPdf || 'Edit PDF' },
                ].map(tool => (
                    <a
                        href={tool.href}
                        class="flex items-center gap-2.5 p-3 bg-white border border-slate-200 rounded-xl text-sm font-semibold text-slate-700 hover:border-indigo-300 hover:text-indigo-700 hover:shadow-sm transition-all group"
                    >
                        <span class="text-lg">{tool.emoji}</span>
                        <span class="group-hover:translate-x-0.5 transition-transform">{tool.label}</span>
                    </a>
                ))}
            </div>
        </div>
    </section>

    <CookieBanner client:idle dict={dict} slot="cookie-banner" />
</BlogPostLayout>
