---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import { getDictionary } from '../../../i18n/dictionary';
import { getCollection } from 'astro:content';
import Navbar from '../../../components/landing/Navbar';
import CookieBanner from '../../../components/landing/CookieBanner';
import { supabase } from '../../../lib/supabase';

const { lang } = Astro.params;
const dict = getDictionary(lang);

// 1. Fetch live posts from Supabase
let dbPosts = [];
try {
    const { data, error } = await supabase
        .from('blog_posts')
        .select('*')
        .eq('lang', lang)
        .eq('is_published', true)
        .order('created_at', { ascending: false });

    if (!error && data) {
        dbPosts = data;
    }
} catch (e) {
    console.error('Supabase blog fetch error:', e);
}

// 2. Fetch fallback local markdown posts
let localPosts = [];
try {
    const allLocal = await getCollection('blog');
    localPosts = allLocal
        .filter(post => post.id.startsWith(`${lang}/`))
        .map(post => ({
            id: post.id,
            slug: post.id.replace(`${lang}/`, ''),
            title: post.data.title,
            description: post.data.description,
            category: post.data.category,
            date: post.data.date,
            image: post.data.image,
            readingTime: Math.ceil((typeof post.body === 'string' ? post.body : '').split(/\s+/).length / 200),
            source: 'local'
        }));
} catch (e) {
    console.error('Local collection fetch error:', e);
}

// 3. Format database posts to match unified shape
const dbFormatted = dbPosts.map(p => ({
    id: `${p.lang}/${p.slug}`,
    slug: p.slug,
    title: p.title,
    description: p.description,
    category: p.category || 'Guides',
    date: new Date(p.published_at || p.created_at),
    image: p.cover_image,
    readingTime: Math.ceil((p.content || '').split(/\s+/).length / 200),
    source: 'supabase'
}));

// 4. Combine: DB posts override local posts with identical slugs
const dbSlugs = new Set(dbFormatted.map(p => p.slug));
const posts = [
    ...dbFormatted,
    ...localPosts.filter(p => !dbSlugs.has(p.slug))
].sort((a, b) => b.date.getTime() - a.date.getTime());
---

<Layout
    lang={lang}
    dict={dict}
    title={dict?.metadata?.blog?.title || "Blog | KeepPDF"}
    description={dict?.metadata?.blog?.description || "KeepPDF Blog"}
>
    <Navbar client:load lang={lang} dict={dict} slot="navbar" />

    <!-- Blog Hero -->
    <section class="relative py-16 bg-gradient-to-b from-white via-indigo-50/30 to-white overflow-hidden">
        <div class="absolute inset-0 pointer-events-none overflow-hidden">
            <div class="absolute -top-40 -right-40 w-96 h-96 bg-indigo-100/30 rounded-full blur-3xl"></div>
            <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-purple-100/20 rounded-full blur-3xl"></div>
        </div>
        <div class="container-custom text-center relative z-10 px-4">
            <h1 class="text-3xl md:text-5xl font-black tracking-tight text-slate-900 mb-4">
                {dict?.metadata?.blog?.h1 || "KeepPDF Blog"}
            </h1>
            <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto">
                {dict?.blog?.description || "Tips, guides, and tutorials about PDF tools"}
            </p>
        </div>
    </section>

    <!-- Blog Grid -->
    <section class="py-16 bg-white">
        <div class="container-custom max-w-5xl mx-auto px-4">
            {posts.length === 0 ? (
                <div class="text-center py-20">
                    <div class="text-6xl mb-4">📝</div>
                    <p class="text-slate-500 text-lg">{dict?.blog?.noPosts || "No posts yet. Check back soon!"}</p>
                </div>
            ) : (
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {posts.map(post => {
                        return (
                            <a
                                href={`/${lang}/blog/${post.slug}`}
                                class="group bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-xl hover:shadow-indigo-500/5 hover:-translate-y-1 transition-all duration-300 overflow-hidden flex flex-col"
                            >
                                {post.image ? (
                                    <div class="aspect-video bg-gradient-to-br from-indigo-100 to-indigo-50 overflow-hidden">
                                        <img
                                            src={post.image}
                                            alt={post.title}
                                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                            loading="lazy"
                                        />
                                    </div>
                                ) : (
                                    <div class="aspect-video bg-gradient-to-br from-indigo-100 to-purple-100 flex items-center justify-center">
                                        <svg class="w-16 h-16 text-indigo-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                            <path d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
                                        </svg>
                                    </div>
                                )}
                                <div class="p-6 flex flex-col flex-grow">
                                    <div class="flex items-center gap-3 mb-3">
                                        <span class="text-xs font-semibold text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded-full uppercase tracking-wider">
                                            {dict?.blog?.categories?.[post.category] || post.category}
                                        </span>
                                        <span class="text-xs text-slate-400">
                                            {post.readingTime} {dict?.blog?.minRead || "min read"}
                                        </span>
                                    </div>
                                    <h2 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-indigo-600 transition-colors line-clamp-2">
                                        {post.title}
                                    </h2>
                                    <p class="text-sm text-slate-500 leading-relaxed line-clamp-3 mb-4 flex-grow">
                                        {post.description}
                                    </p>
                                    <div class="flex items-center justify-between text-xs text-slate-400 pt-3 border-t border-slate-100">
                                        <span>{post.date.toLocaleDateString(lang === 'tr' ? 'tr-TR' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
                                        <span class="text-indigo-600 font-bold group-hover:translate-x-0.5 transition-transform flex items-center gap-1">
                                            {dict?.blog?.readMore || "Read More"} &rarr;
                                        </span>
                                    </div>
                                </div>
                            </a>
                        );
                    })}
                </div>
            )}
        </div>
    </section>

    <CookieBanner client:idle dict={dict} slot="cookie-banner" />
</Layout>
